{
  "manifest_version": 3,
  "name": "Claude Browser Hands",
  "version": "0.3.1",
  "description": "Lets Claude (via Claude in Chrome on https://example.com) manage other extensions and refresh, recover and adopt tabs.",
  "key": "",
  "permissions": ["management", "tabs", "tabGroups"],
  "background": { "service_worker": "background.js" },
  "externally_connectable": { "matches": ["https://example.com/*"] }
}
