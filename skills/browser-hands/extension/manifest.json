{
  "manifest_version": 3,
  "name": "Claude Browser Hands",
  "version": "0.5.0",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Claude Browser Hands", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "description": "Lets Claude (via Claude in Chrome, control tab on slashunderscore.com) manage extensions and refresh, recover and adopt tabs.",
  "homepage_url": "https://slashunderscore.com/",
  "key": "",
  "permissions": ["management", "tabs", "tabGroups"],
  "background": { "service_worker": "background.js" },
  "externally_connectable": { "matches": ["https://slashunderscore.com/*", "https://example.com/*", "http://localhost/*", "http://127.0.0.1/*"] },
  "content_scripts": [{ "matches": ["https://slashunderscore.com/*", "https://example.com/*"], "js": ["control-tab.js"], "run_at": "document_end" }],
  "web_accessible_resources": [{ "resources": ["icons/*"], "matches": ["https://slashunderscore.com/*", "https://example.com/*"] }]
}
